# =============================================================================
# The Boardroom — copy to `.env` and fill in. Do not commit `.env`.
# =============================================================================

# --- Google Cloud / Gemini ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
GEMINI_API_KEY=your_gemini_api_key
# All directors + Chairman reason with this. Must be a Gemini 3.X family model.
GEMINI_MODEL=gemini-3.5-flash
# Live transcription model. As of June 2026, the only Live-capable model
# available to most accounts is gemini-3.1-flash-live-preview (the only
# gemini-3.X family member that supports bidiGenerateContent).
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# TTS for voice Q&A replies.
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# --- MongoDB Atlas (the partner MCP integration) ---
# Connection string from Atlas → Connect → Drivers.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/boardroom?retryWrites=true&w=majority
MONGODB_DB=boardroom
# Local URL of the MongoDB MCP server (started in the same container — see Dockerfile).
MONGODB_MCP_URL=http://127.0.0.1:8088
MDB_MCP_CONNECTION_STRING=${MONGODB_URI}

# --- Market data adapters (real APIs) ---
# Used by directors for grounding (analyst consensus, peer comps, macro, news).
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
FINNHUB_API_KEY=your_finnhub_key
FMP_API_KEY=your_fmp_key
FRED_API_KEY=your_fred_key

# --- Alpaca paper trading (one-tap execution) ---
ALPACA_API_KEY=your_paper_key
ALPACA_SECRET_KEY=your_paper_secret
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- YouTube Live / audio extraction (for non-tab-share sources) ---
# yt-dlp is bundled in the container; no key required, but rate-limited.

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080

# --- Optional: Telegram pre-event push notifications ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
